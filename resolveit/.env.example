# OpenAI Responses API — server-side only, used for advisory incident investigation
OPENAI_API_KEY=

# Session signing secret — required for sign-in. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Vapi browser voice configuration.
# Vapi documents the public key as safe for browser use; restrict it to this origin and assistant.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# Human escalation — the IT support line that escalated PHONE calls are transferred to (E.164, e.g. +14155550100).
# Server-side only: sent to Vapi as the transfer destination, never shown to employees or the browser.
IT_SUPPORT_PHONE=

# Vapi phone channel (server-side). Vapi sends this secret with every webhook request to /api/vapi/webhook.
# Generate a long random value locally and enter the same value as a Bearer-token credential in Vapi.
VAPI_WEBHOOK_SECRET=
# The ResolveIT AI phone number employees call. Shown on the employee dashboard.
RESOLVEIT_AI_PHONE_NUMBER=
# blind-transfer (default) | warm-transfer-say-message | warm-transfer-say-summary (warm modes need a Twilio number)
VAPI_TRANSFER_MODE=

# Local PostgreSQL — generate a private password for .env.local; these are not production credentials
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
